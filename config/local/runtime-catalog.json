{
  "schema_version": "1.0.0",
  "backend": {
    "source_status": "fastapi_full_assessment_api_implemented",
    "dockerfile": "backend/Dockerfile",
    "context": ".",
    "port": 8000,
    "enabled_by_default": true
  },
  "worker": {
    "source_status": "celery_entrypoint_implemented",
    "same_image_as": "backend",
    "scheduler": "separate_single_replica",
    "enabled_by_default": true
  },
  "frontend": {
    "source_status": "react_vite_dockerfile_implemented",
    "enabled_by_default": true
  },
  "storage": {
    "mode": "http_sources_and_shared_upload_pvc",
    "adapter": "CachedHttpSourceStorage",
    "shared_upload_pvc": "legal-shared-files"
  },
  "redis": {
    "status": "authenticated_celery_broker",
    "result_store": "postgresql"
  }
}
